# =============================================================================
# قسم سحب الأرقام - Number Extraction Section — Environment Configuration
# انسخ هذا الملف إلى .env وعدّل القيم / Copy this file to .env and fill in values
# =============================================================================

# --- General ---
NODE_ENV=development
PORT=4000
# رابط الواجهة الأمامية المسموح له بالاتصال (CORS) — عدّله لرابط Railway الخاص بالواجهة عند النشر
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
# على Railway: أضف Plugin من نوع PostgreSQL وسيتم توفير DATABASE_URL تلقائياً
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wa_number_extraction

# --- Redis (BullMQ queue) ---
# على Railway: أضف Plugin من نوع Redis وسيتم توفير REDIS_URL تلقائياً
REDIS_URL=redis://localhost:6379

# --- Auth / JWT ---
# ولّد قيماً عشوائية طويلة، مثال: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# --- Encryption (AES-256-GCM for WhatsApp session data at rest) ---
# يجب أن يكون 32 بايت بترميز hex (64 حرف). ولّده بالأمر التالي:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_TO_A_64_CHAR_HEX_STRING_32_BYTES

# --- Initial admin user (used by `npm run db:seed`) ---
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Logging ---
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Official WhatsApp Business Cloud API (never commit real tokens)
WHATSAPP_API_VERSION=v23.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com
