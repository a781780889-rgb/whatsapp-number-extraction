NODE_ENV=production
PORT=4000
CORS_ORIGIN=https://your-dashboard.example.com
DATABASE_URL=postgresql://user:password@host:5432/wa_number_extraction
REDIS_URL=redis://host:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=64-hex-characters-required
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-before-first-boot
WHATSAPP_API_VERSION=v23.0
WHATSAPP_GRAPH_API_BASE_URL=https://graph.facebook.com

META_APP_ID=replace-with-meta-app-id
META_APP_SECRET=replace-with-server-only-meta-app-secret
META_EMBEDDED_SIGNUP_CONFIG_ID=replace-with-embedded-signup-v4-config-id
META_EMBEDDED_SIGNUP_REDIRECT_URI=https://your-dashboard.example.com/whatsapp/embedded-signup
